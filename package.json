{
  "name": "crack-the-pass",
  "version": "1.0.0",
  "private": true,
  "description": "Classroom game where students brute-force passwords of 1 to 4 characters and learn how weak short passwords are.",
  "main": "server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning server.js",
    "reset": "node --disable-warning=ExperimentalWarning scripts/reset-leaderboard.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3"
  }
}
